#!/usr/bin/env bash
# jamai-on-drop <fichier> — appelé par jamai-watch pour chaque dépôt neuf.
#
# ZÉRO token de modèle. Il établit ce qu'est le fichier, à la mesure, et range
# tout dans un dossier. Whisper (Groq) est appelé pour la parole : ~$0,0001 par
# minute d'audio, et ce n'est pas moi.
#
# Résultat : ~/.local/state/episode-voice/drops/<nom>/
#     verdict.txt   la ligne qui résume — parole / musique / midi / silence
#     probe.txt     ffprobe
#     mesure.txt    timbre, énergie par bande, pouls, carte temporelle
#     notes.txt     (MIDI) le relevé note à note
#     texte.txt     (parole) la transcription horodatée
#
# Il ne compose rien et ne décide rien. Il prépare le terrain.
set -uo pipefail

F="${1:?usage: jamai-on-drop <fichier>}"
[ -f "$F" ] || { echo "introuvable : $F" >&2; exit 1; }

D="$HOME/.agents/skills/jamai-morning/scripts"
OUT="$HOME/.local/state/episode-voice/drops/$(basename "$F")"
mkdir -p "$OUT"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

verdict() { printf '%s\n' "$*" | tee "$OUT/verdict.txt"; }

case "$(printf '%s' "$F" | tr '[:upper:]' '[:lower:]')" in

  *.mid|*.midi)
    python3 "$D/jamai-midi.py" "$F" > "$TMP/notes.txt" 2>&1 || { verdict "MIDI illisible"; exit 1; }
    # Compter AVANT d'ajouter la sortie de l'outil d'accords, sinon ses lignes
    # sont comptées comme des notes. Et prendre le DERNIER événement tempo :
    # un exporteur en écrit souvent deux, et c'est le dernier qui s'applique.
    n=$(awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9.]+$/ {c++} END{print c+0}' "$TMP/notes.txt")
    bpm=$(grep -o 'tempo [0-9.]* BPM' "$TMP/notes.txt" | tail -1)
    amb=$(sed -n 's/^ *ambitus *: *//p' "$TMP/notes.txt" | tail -1)
    cp "$TMP/notes.txt" "$OUT/notes.txt"
    python3 "$D/jamai-chords.py" "$F" 4 >> "$OUT/notes.txt" 2>&1 || true
    verdict "MIDI — $n notes, ${bpm:-tempo inconnu}${amb:+, ambitus $amb}. Relevé : $OUT/notes.txt"
    ;;

  *.m4a|*.mp3|*.wav|*.mp4|*.mov|*.webm|*.ogg|*.flac)
    ffprobe -v error -show_format -show_streams -of default=noprint_wrappers=1 "$F" \
      > "$OUT/probe.txt" 2>&1
    ffmpeg -v error -y -i "$F" -map 0:a:0 -ac 1 -ar 22050 "$TMP/a.wav" 2>/dev/null \
      || { verdict "aucune piste audio exploitable"; exit 0; }

    python3 "$D/jamai-measure.py" "$TMP/a.wav" > "$OUT/mesure.txt" 2>&1 || true
    cen=$(sed -n 's/^centroïde spectral *: *\([0-9]*\) Hz/\1/p' "$OUT/mesure.txt" | head -1)
    sub=$(sed -n 's/^ *0– *250 Hz *: *\([0-9.]*\) %.*/\1/p'     "$OUT/mesure.txt" | head -1)
    dur=$(sed -n 's/^durée *: *\([0-9.]*\) s.*/\1/p'            "$OUT/mesure.txt" | head -1)

    # Le discriminant fiable est le GRAVE, pas le médium. Mesuré sur les dépôts
    # de la séance : parole 13,8 / 17,6 / 37,6 % sous 250 Hz ; fredon 73,1 %.
    # Mon premier seuil (médium > 60 %) classait 260804222416.mov en musique
    # alors que c'est une consigne parlée — son médium n'était qu'à 53,3 %.
    kind=musique
    awk "BEGIN{exit !(${sub:-100} < 50 && ${cen:-0} > 350)}" && kind=parole

    if [ "$kind" = parole ]; then
      KEY=$(grep -m1 '^GROQ_API_KEY=' "$HOME/.env" 2>/dev/null | cut -d= -f2-)
      if [ -n "${KEY:-}" ]; then
        ffmpeg -v error -y -i "$F" -map 0:a:0 -c:a aac -b:a 96k -ac 1 "$TMP/a.m4a" 2>/dev/null
        curl -s --max-time 180 https://api.groq.com/openai/v1/audio/transcriptions \
          -H "Authorization: Bearer $KEY" -F "file=@$TMP/a.m4a" \
          -F model=whisper-large-v3 -F language=fr -F response_format=verbose_json \
          > "$TMP/g.json" 2>/dev/null
        python3 - "$TMP/g.json" > "$OUT/texte.txt" <<'PY' 2>/dev/null || true
import json,sys
d=json.load(open(sys.argv[1]))
if 'error' in d: print('ERREUR:', d['error']); raise SystemExit
for s in d.get('segments',[]): print(f"[{s['start']:6.1f}] {s['text'].strip()}")
PY
      fi
      head=$(head -c 220 "$OUT/texte.txt" 2>/dev/null | tr '\n' ' ')
      verdict "PAROLE — ${dur:-?} s, centroïde ${cen:-?} Hz. ${head:-transcription indisponible}"
    else
      verdict "MUSIQUE — ${dur:-?} s, centroïde ${cen:-?} Hz, ${sub:-?} % sous 250 Hz. Mesure : $OUT/mesure.txt"
    fi
    ;;

  *.txt|*.md|*.json)
    cp "$F" "$OUT/texte.txt"
    verdict "TEXTE — $(wc -l < "$F") lignes, $(wc -c < "$F") octets"
    ;;

  *)
    verdict "type non traité : $(basename "$F")"
    ;;
esac
