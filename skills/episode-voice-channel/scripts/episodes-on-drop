#!/usr/bin/env bash
# episodes-on-drop <fichier> — le crochet de l'atelier `episodes`.
#
# Appelé par `episodes-watch` pour chaque fichier neuf tombé dans
# ~/Recordings-episodes/. Il mesure, transcrit, RANGE dans un épisode, et
# lance la recherche d'épisodes reliés. Il ne nomme rien : nommer est un
# jugement, et le jugement reste à Jerry.
#
# ZÉRO token de modèle. bash + ffmpeg + python + Whisper (Groq, ~0,0001 $/min).
#
# Ce qu'il produit :
#   ~/.local/state/episode-voice/drops-episodes/<nom>/
#       verdict.txt   ce qui a été établi et ce qui reste à juger
#       probe.txt     ffprobe
#       mesure.txt    timbre, bandes, pouls
#       texte.txt     (parole) transcription horodatée
#       relies.txt    (si le chercheur de la voie 4 est posé) épisodes reliés
#   et, sur le portail 8778 :
#       l'épisode ep-NNN, avec le clip attaché et la transcription en section
#
# Le chercheur d'épisodes reliés est un contrat, pas une dépendance :
#   $HOME/.agents/skills/episode-voice-channel/scripts/episodes-related <texte.txt>
# S'il existe et est exécutable, sa sortie standard est déposée telle quelle.
# S'il n'existe pas, le verdict le nomme comme un trou — il ne l'invente pas.
set -uo pipefail

F="${1:?usage: episodes-on-drop <fichier>}"
[ -f "$F" ] || { echo "introuvable : $F" >&2; exit 1; }

JD="$HOME/.agents/skills/jamai-morning/scripts"          # mesure/midi/accords, déjà éprouvés
ED="$HOME/.agents/skills/episode-voice-channel/scripts"
EP="$ED/episode"
RELATED="$ED/episodes-related"                            # voie 4 — contrat, peut manquer
STATE="$HOME/.local/state/episode-voice"
OUT="$STATE/drops-episodes/$(basename "$F")"
UNITE="$STATE/episodes-unite.txt"                         # dernier ep-NNN ouvert par le crochet
LOCK="$STATE/episodes-numero.lock"                        # deux veilles ne réclament pas le même numéro
FENETRE=5400                                              # 90 min : un même dépôt-séance reste un seul épisode

export PIXEL_RECORDER_URL="${PIXEL_RECORDER_URL:-https://localhost:8778}"

mkdir -p "$OUT" "$STATE/drops-episodes"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"; rmdir "$LOCK" 2>/dev/null || true' EXIT

: > "$OUT/verdict.txt"
dire() { printf '%s\n' "$*" | tee -a "$OUT/verdict.txt"; }

# ------------------------------------------------------------------ 1. mesure
case "$(printf '%s' "$F" | tr '[:upper:]' '[:lower:]')" in
  *.m4a|*.mp3|*.wav|*.mp4|*.mov|*.webm|*.ogg|*.flac) ;;
  *.mid|*.midi)
    python3 "$JD/jamai-midi.py" "$F" > "$OUT/notes.txt" 2>&1 \
      && dire "MIDI — relevé dans $OUT/notes.txt. Rien rangé : un MIDI n'est pas un épisode." \
      || dire "MIDI illisible."
    exit 0 ;;
  *)
    dire "type non traité : $(basename "$F"). Rien rangé."
    exit 0 ;;
esac

ffprobe -v error -show_format -show_streams -of default=noprint_wrappers=1 "$F" > "$OUT/probe.txt" 2>&1
ffmpeg -v error -y -i "$F" -map 0:a:0 -ac 1 -ar 22050 "$TMP/a.wav" 2>/dev/null \
  || { dire "aucune piste audio exploitable. Rien rangé."; exit 0; }

python3 "$JD/jamai-measure.py" "$TMP/a.wav" > "$OUT/mesure.txt" 2>&1 || true
cen=$(sed -n 's/^centroïde spectral *: *\([0-9]*\) Hz/\1/p' "$OUT/mesure.txt" | head -1)
sub=$(sed -n 's/^ *0– *250 Hz *: *\([0-9.]*\) %.*/\1/p'     "$OUT/mesure.txt" | head -1)
dur=$(sed -n 's/^durée *: *\([0-9.]*\) s.*/\1/p'            "$OUT/mesure.txt" | head -1)

# Le discriminant fiable est le GRAVE, pas le médium. Mesuré sur les dépôts de
# la séance : parole 13,8 / 17,6 / 37,6 % sous 250 Hz ; fredon 73,1 %. Le seuil
# médium (>60 %) avait classé une consigne parlée en musique à 53,3 %.
kind=musique
awk "BEGIN{exit !(${sub:-100} < 50 && ${cen:-0} > 350)}" && kind=parole

if [ "$kind" != parole ]; then
  dire "MUSIQUE — ${dur:-?} s, centroïde ${cen:-?} Hz, ${sub:-?} % sous 250 Hz."
  dire "Pas rangé en épisode : un épisode se range sur ce qui est dit."
  dire "Mesure : $OUT/mesure.txt"
  exit 0
fi

# ------------------------------------------------------------- 2. transcription
KEY=$(grep -m1 '^GROQ_API_KEY=' "$HOME/.env" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"'' | tr -d '\r')
if [ -z "${KEY:-}" ]; then
  dire "PAROLE — ${dur:-?} s, centroïde ${cen:-?} Hz, ${sub:-?} % sous 250 Hz."
  dire "TROU : pas de GROQ_API_KEY dans ~/.env — sans transcription, rien à ranger ni à relier."
  exit 1
fi

ffmpeg -v error -y -i "$F" -map 0:a:0 -c:a aac -b:a 96k -ac 1 "$TMP/a.m4a" 2>/dev/null
curl -s --max-time 300 https://api.groq.com/openai/v1/audio/transcriptions \
  -H "Authorization: Bearer $KEY" -F "file=@$TMP/a.m4a" \
  -F model=whisper-large-v3 -F language=fr -F response_format=verbose_json \
  > "$TMP/g.json" 2>/dev/null

python3 - "$TMP/g.json" > "$OUT/texte.txt" <<'PY' 2>/dev/null || true
import json, sys
d = json.load(open(sys.argv[1]))
if 'error' in d:
    print('ERREUR:', d['error']); raise SystemExit
for s in d.get('segments', []):
    print(f"[{s['start']:6.1f}] {s['text'].strip()}")
PY

if [ ! -s "$OUT/texte.txt" ] || grep -q '^ERREUR:' "$OUT/texte.txt"; then
  dire "PAROLE — ${dur:-?} s, centroïde ${cen:-?} Hz."
  dire "TROU : transcription indisponible ($(head -c 120 "$OUT/texte.txt" 2>/dev/null))."
  dire "Le clip est intact dans $F — rien n'est perdu, seulement non rangé."
  exit 1
fi
mots=$(wc -w < "$OUT/texte.txt")
dire "PAROLE — ${dur:-?} s, centroïde ${cen:-?} Hz, ${sub:-?} % sous 250 Hz, $mots mots."

# ------------------------------------------------------- 3. quel épisode reçoit
# « créé ou complété » : une rafale du même matin reste un seul épisode ; un
# dépôt qui arrive après la fenêtre en ouvre un neuf. La règle est un CHOIX,
# elle est ici pour être discutée, pas pour être devinée.
i=0
while ! mkdir "$LOCK" 2>/dev/null; do
  i=$((i+1)); [ "$i" -gt 60 ] && { dire "TROU : verrou de numérotation tenu depuis 60 s — rien rangé."; exit 1; }
  sleep 1
done

slug=""
if [ -s "$UNITE" ]; then
  read -r prev_slug prev_ts < "$UNITE" || true
  now=$(date +%s)
  if [ -n "${prev_slug:-}" ] && [ $(( now - ${prev_ts:-0} )) -lt "$FENETRE" ]; then
    # le vérifier sur le portail, jamais le croire sur parole
    if "$EP" status 2>/dev/null | grep -q -- "$prev_slug"; then slug="$prev_slug"; fi
  fi
fi

if [ -z "$slug" ]; then
  n="$(curl -sk --max-time 15 "$PIXEL_RECORDER_URL/api/compositions" | python3 -c '
import json, re, sys
n = 0
for c in json.load(sys.stdin):
    m = re.match(r"ep-(\d+)", c.get("slug", ""))
    if m: n = max(n, int(m.group(1)))
print("%03d" % (n + 1))' 2>/dev/null || true)"
  case "$n" in ''|*[!0-9]*) dire "TROU : numéro d'épisode indéterminable — portail muet. Rien rangé."; exit 1 ;; esac
  # Titre nu : `ep-009`. Le crochet ne nomme pas — nommer est le jugement qui
  # reste. Le renommage plus tard ne coûte rien (episodes-rename).
  slug="$("$EP" open "ep-$n" 2>/dev/null | tail -1)"
  [ -n "$slug" ] || { dire "TROU : création de ep-$n refusée par le portail. Rien rangé."; exit 1; }
  dire "ÉPISODE OUVERT — $slug (titre nu : à nommer)."
else
  dire "ÉPISODE COMPLÉTÉ — $slug (dépôt dans la fenêtre de $((FENETRE/60)) min)."
fi
printf '%s %s\n' "$slug" "$(date +%s)" > "$UNITE"
rmdir "$LOCK" 2>/dev/null || true

# ------------------------------------------ 4. attacher le clip et le transcrit
base="$(basename "$F")"
if curl -sk --max-time 60 -X POST "$PIXEL_RECORDER_URL/api/compositions/$slug/clips" \
     -H 'Content-Type: application/json' \
     -d "$(python3 -c 'import json,sys; print(json.dumps({"filename": sys.argv[1], "label": "dépôt " + sys.argv[2]}))' "$base" "$(date '+%Y-%m-%d %H:%M')")" \
     | grep -q '"success":true'; then
  dire "  clip attaché — $base"
else
  dire "  TROU : clip non attaché — $base reste dans ~/Recordings-episodes/"
fi

python3 - "$OUT/texte.txt" "$slug" "$base" "$PIXEL_RECORDER_URL" <<'PY' >>"$OUT/verdict.txt" 2>&1 || true
import json, sys, urllib.request, ssl
texte, slug, src, portal = sys.argv[1:5]
body = json.dumps({"text": open(texte).read(), "lang": "fr",
                   "label": "Transcription du dépôt", "sourceFilename": src}).encode()
ctx = ssl._create_unverified_context()
req = urllib.request.Request(f"{portal}/api/compositions/{slug}/texts", data=body,
                             headers={"Content-Type": "application/json"}, method="POST")
try:
    r = json.load(urllib.request.urlopen(req, context=ctx, timeout=60))
    print("  transcription déposée" if r.get("success") else f"  TROU : transcription refusée — {r}")
except Exception as e:
    print(f"  TROU : transcription refusée — {e}")
PY

# ------------------------------------------------- 5. les épisodes reliés (v4)
if [ -x "$RELATED" ]; then
  # Le portail nomme chaque section texte transcription_<AAAAMMJJHHMMSS>_FR.txt :
  # la granularité est la SECONDE. Deux dépôts dans la même seconde portent le
  # même nom et le second écrase le premier sur disque — silencieusement, avec
  # un 200. Vu le 2026-08-05 à 07:25:42 : la transcription de ep-009 avait
  # disparu du disque, remplacée par les reliés (elle ne survivait que dans le
  # champ content de composition.json). On laisse donc passer la seconde.
  sleep 2
  if "$RELATED" "$OUT/texte.txt" > "$OUT/relies.txt" 2>"$TMP/rel.err" && [ -s "$OUT/relies.txt" ]; then
    python3 - "$OUT/relies.txt" "$slug" "$PIXEL_RECORDER_URL" <<'PY' >>"$OUT/verdict.txt" 2>&1 || true
import json, sys, urllib.request, ssl
relies, slug, portal = sys.argv[1:4]
corps = open(relies).read()
ctx = ssl._create_unverified_context()

def post(path, body):
    req = urllib.request.Request(f"{portal}{path}", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"}, method="POST")
    return json.load(urllib.request.urlopen(req, context=ctx, timeout=60))

# `links` n'est PAS dans la liste blanche du PUT du portail — un links[] écrit
# par l'API disparaîtrait en silence avec un 200. On dépose donc les relations
# là où elles survivent : une section texte (un vrai fichier sur disque).
try:
    r = post(f"/api/compositions/{slug}/texts",
             {"text": corps, "lang": "fr", "label": "Épisodes reliés"})
    print("  épisodes reliés déposés" if r.get("success") else f"  TROU : reliés refusés — {r}")
except Exception as e:
    print(f"  TROU : reliés refusés — {e}")
PY
    dire "  reliés trouvés : $(grep -c . "$OUT/relies.txt") lignes → $OUT/relies.txt"
  else
    dire "  TROU : $RELATED a échoué — $(head -c 160 "$TMP/rel.err" 2>/dev/null)"
  fi
else
  dire "  TROU NOMMÉ : pas de chercheur d'épisodes reliés en $RELATED (voie 4)."
  dire "  La transcription est en place ; la recherche se rejouera dès qu'il sera posé :"
  dire "    $RELATED $OUT/texte.txt"
fi

# ------------------------------------------------------------- 6. ce qui reste
dire ""
dire "RESTE À JUGER — nommer $slug. Proposition de titre : personne, c'est le jugement."
dire "  transcription : $OUT/texte.txt"
dire "  épisode       : $HOME/compositions-episodes/$slug/"
dire "  renommer      : $ED/episodes-rename $slug \"<titre>\""
